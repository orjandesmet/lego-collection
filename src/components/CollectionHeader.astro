---
type Accent = 'amber' | 'cyan' | 'lime' | 'fuchsia';

type Stat = {
  label: string;
  value: number;
  accent: Accent;
};

type Props = {
  overviewLabel: string;
  title: string;
  stats: Stat[];
};

const { overviewLabel, title, stats } = Astro.props;

const accentClassMap: Record<Accent, string> = {
  amber:
    'border-amber-200 bg-amber-100/70 text-amber-950 dark:border-amber-300/45 dark:bg-amber-900/35 dark:text-amber-100',
  cyan: 'border-cyan-200 bg-cyan-100/70 text-cyan-950 dark:border-cyan-300/45 dark:bg-cyan-900/35 dark:text-cyan-100',
  lime: 'border-lime-200 bg-lime-100/70 text-lime-950 dark:border-lime-300/45 dark:bg-lime-900/35 dark:text-lime-100',
  fuchsia:
    'border-fuchsia-200 bg-fuchsia-100/70 text-fuchsia-950 dark:border-fuchsia-300/45 dark:bg-fuchsia-900/35 dark:text-fuchsia-100',
};
---

<header
  class="animate-rise rounded-3xl border border-slate-900/10 bg-white/75 p-6 shadow-lg shadow-slate-900/10 backdrop-blur-sm dark:border-slate-200/10 dark:bg-slate-900/60 dark:shadow-slate-950/35 md:p-8"
>
  <p
    class="text-sm font-semibold uppercase tracking-[0.16em] text-slate-500 dark:text-slate-300"
  >
    {overviewLabel}
  </p>
  <h1
    class="mt-3 text-4xl font-bold text-slate-900 dark:text-slate-100 md:text-5xl"
  >
    {title}
  </h1>
  <div class="mt-5 grid gap-3 sm:grid-cols-3">
    {
      stats.map((stat) => (
        <p
          class:list={[
            'rounded-xl border px-3 py-2 text-sm',
            accentClassMap[stat.accent],
          ]}
        >
          <strong>{stat.value}</strong> {stat.label}
        </p>
      ))
    }
  </div>
</header>

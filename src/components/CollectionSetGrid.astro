---
import type { CollectionEntry } from 'astro:content';

import LegoSetListItem from './LegoSetListItem.astro';

type Props = {
  collection: 'sets' | 'minifigs';
  items: CollectionEntry<'sets' | 'minifigs'>[];
  showVariant?: boolean;
};

const { collection, items, showVariant } = Astro.props as Props;
---

<ul class="grid gap-3 md:grid-cols-2 xl:grid-cols-3" data-search-grid>
  {
    items.map((item) => (
      <li>
        <LegoSetListItem
          collection={collection}
          legoSetData={item.data}
          setId={item.id}
          showVariant={showVariant}
        />
      </li>
    ))
  }
  <li
    data-search-empty
    hidden
    class="col-span-full py-4 text-center text-sm text-slate-500 dark:text-slate-400"
  >
    No results found.
  </li>
</ul>

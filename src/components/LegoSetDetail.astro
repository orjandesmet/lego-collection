---
import { setUtils } from '@utils/setUtils';
import { type CollectionEntry, getCollection } from 'astro:content';
import LegoSetHeader from './LegoSetHeader.astro';
import LegoSetImage from './LegoSetImage.astro';
import LegoSetInfoBlock from './LegoSetInfoBlock.astro';

type Props = {
  collection: 'sets' | 'minifigs';
  legoSetData: CollectionEntry<'sets' | 'minifigs'>['data'];
};
const { collection, legoSetData } = Astro.props;

const themes = await getCollection('themes');

const buildTime = setUtils.stringifyBuildTime(legoSetData);
const { setNumber, variant } = setUtils.getSetNumberAndVariant(legoSetData);
const taxonomy = setUtils.getTaxonomy(themes)(legoSetData);
const isWishlist = legoSetData.wishlist ?? false;
const isPromotionalSet = setUtils.isPromotionalSet(legoSetData);
const showVariant = collection === 'minifigs';
const detailAccentClass =
  collection === 'sets'
    ? 'border-amber-200/80 shadow-amber-900/10 dark:border-amber-300/35 dark:shadow-amber-950/20'
    : 'border-fuchsia-200/80 shadow-fuchsia-900/10 dark:border-fuchsia-300/35 dark:shadow-fuchsia-950/20';
const imageAccentClass =
  collection === 'sets'
    ? 'ring-1 ring-cyan-200/70 dark:ring-cyan-300/35'
    : 'ring-1 ring-lime-200/80 dark:ring-lime-300/35';
---

<article
  class:list={[
    'detail-card rounded-3xl border bg-white/75 p-3 shadow-lg backdrop-blur-sm dark:bg-slate-900/60 dark:shadow-slate-950/35 md:p-5',
    detailAccentClass,
  ]}
>
  <LegoSetHeader
    title={legoSetData.name}
    taxonomy={taxonomy}
    wishlist={isWishlist}
  />
  <div
    class:list={[
      'mt-4 rounded-2xl bg-white/90 p-3 shadow-sm shadow-slate-900/10 dark:bg-slate-800/80 dark:shadow-slate-950/35 md:p-5',
      imageAccentClass,
    ]}
  >
    <LegoSetImage img={legoSetData.img} alt={legoSetData.name} />
  </div>
  <section class="py-5">
    <div
      class="mx-auto flex w-fit flex-wrap items-stretch justify-center gap-3 md:gap-4"
    >
      <LegoSetInfoBlock
        icon="pound"
        title={collection === 'sets' ? 'Set N°' : 'Minifig N°'}
        >{showVariant ? `${setNumber}-${variant}` : setNumber}</LegoSetInfoBlock
      >
      <LegoSetInfoBlock icon="brick" title="Pieces"
        >{legoSetData.parts}</LegoSetInfoBlock
      >
      <LegoSetInfoBlock icon="calendar" title="Added to collection"
        >{legoSetData.dateAdded}</LegoSetInfoBlock
      >
      {
        buildTime && (
          <LegoSetInfoBlock icon="stopwatch" title="Build time">
            {buildTime}
          </LegoSetInfoBlock>
        )
      }
      {
        !isPromotionalSet && (
          <a
            href={`https://www.lego.com/nl-be/service/building-instructions/${setNumber}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            <LegoSetInfoBlock icon="book-open" title="Open on LEGO.com">
              Instructions{' '}
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="inline-block"
                viewBox="0 0 24 24"
                height="1rem"
                width="1rem"
              >
                <use href="/external.svg#external" />
              </svg>
            </LegoSetInfoBlock>
          </a>
        )
      }
    </div>
  </section>
</article>

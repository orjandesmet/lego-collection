---
type Props = {
  title: string;
  taxonomy?: string;
  wishlist?: boolean;
};
const { title, taxonomy, wishlist } = Astro.props;
---

<header
  class="rounded-2xl border border-slate-900/10 bg-white/80 p-4 shadow-sm shadow-slate-900/10 backdrop-blur-sm dark:border-slate-700 dark:bg-slate-900/60 dark:shadow-slate-950/30 md:p-6"
>
  <div class="mx-auto flex max-w-5xl flex-row gap-3 px-1 md:px-2">
    <div>
      {
        taxonomy && (
          <p class="text-xs uppercase tracking-[0.16em] text-slate-500 dark:text-slate-300">
            {taxonomy}
          </p>
        )
      }
      <h1
        data-wishlist={wishlist}
        class="mt-1 text-2xl font-bold text-slate-900 dark:text-slate-100 md:text-3xl"
      >
        {title}
        {wishlist}
      </h1>
    </div>
  </div>
</header>

<style>
  [data-wishlist='true']::before {
    content: '★';
    display: inline-block;
    margin-right: 4px;
    color: rgb(245, 158, 11);
  }
  [data-wishlist='true']:hover::before {
    animation-timing-function: ease;
    animation-iteration-count: infinite;
    animation-name: twoFrames;
    animation-duration: 2s;
    animation-delay: 3s;
  }

  @keyframes twoFrames {
    100% {
      transform: rotate(360deg);
    }
  }
</style>

---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

type Props = {
  img: CollectionEntry<'sets' | 'minifigs'>['data']['img'];
  alt: string;
  small?: boolean;
};
const { img, alt, small } = Astro.props;
const classNames = ['p-2', 'mx-auto'];
if (small) {
  classNames.push('h-auto', 'w-auto', 'max-h-24', 'sm:max-h-32', 'max-w-full');
} else {
  classNames.push(
    'w-full',
    'max-w-screen-md',
    'px-20',
    'bg-white',
    'dark:bg-slate-900/80',
    'rounded-lg'
  );
}
---

<figure
  class=`relative ${small ? 'bg-white dark:bg-slate-900/80 rounded-lg overflow-hidden' : ''}`
>
  <Image
    src={img}
    alt={`Image for ${alt}`}
    class={classNames.join(' ')}
    loading={small ? 'lazy' : 'eager'}
    decoding="async"
  />
  <div
    class="absolute bottom-0 left-0 right-0 top-0 h-full w-full bg-linear-to-b dark:bg-linear-to-t opacity-10 pointer-events-none from-black to-white rounded-2xl"
  >
  </div>
</figure>

---
type Props = {
  icon: 'book-open' | 'brick' | 'calendar' | 'pound' | 'stopwatch';
  title: string;
};
const { icon, title } = Astro.props;
---

<div
  class="flex min-w-28 flex-col items-center justify-center rounded-xl border border-slate-200 bg-white/85 px-3 py-3 shadow-sm shadow-slate-900/5 dark:border-slate-700 dark:bg-slate-900/70 dark:shadow-slate-950/30"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    class="text-slate-500 dark:text-slate-300"
    width="36px"
    height="36px"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    aria-label={title}
  >
    <use href={`/${icon}.svg#${icon}`}></use>
  </svg>
  <p class="mt-1 text-sm font-bold text-slate-900 dark:text-slate-100">
    <slot />
  </p>
  {
    title && (
      <p class="text-center text-xs text-slate-500 dark:text-slate-300">
        {title}
      </p>
    )
  }
</div>

---
import type { CollectionEntry } from 'astro:content';
import LegoSetRecirculationItem from './LegoSetRecirculationItem.astro';
type Props = {
  collection: 'sets' | 'minifigs';
  title: string;
  sets: Array<CollectionEntry<'sets' | 'minifigs'>>;
  showVariant?: boolean;
};

const { collection, title, sets, showVariant } = Astro.props;
const containerAccentClass =
  collection === 'sets'
    ? 'border-cyan-200/80 shadow-cyan-900/10'
    : 'border-lime-200/80 shadow-lime-900/10';
const titleAccentClass =
  collection === 'sets' ? 'text-cyan-900' : 'text-lime-900';
---

<aside
  class:list={[
    'rounded-3xl border bg-white/70 p-4 shadow-md backdrop-blur-sm md:p-6',
    containerAccentClass,
  ]}
>
  <div class="mx-auto flex max-w-6xl flex-col gap-3 md:gap-4">
    <h3 class:list={['text-lg font-semibold md:text-xl', titleAccentClass]}>
      {title}
    </h3>
    <section class="-mx-4 overflow-x-auto md:mx-0">
      <ul class="flex w-max gap-3 px-4 md:gap-4 md:px-0">
        {
          sets.map((set) => (
            <li>
              <LegoSetRecirculationItem
                collection={collection}
                legoSetData={set.data}
                setId={set.id}
                showVariant={showVariant}
              />
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</aside>

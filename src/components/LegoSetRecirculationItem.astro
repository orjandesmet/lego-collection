---
import type { CollectionEntry } from 'astro:content';
import LegoSetImage from './LegoSetImage.astro';

type Props = {
  collection: 'sets' | 'minifigs';
  legoSetData: CollectionEntry<'sets' | 'minifigs'>['data'];
  setId: string;
  showVariant?: boolean;
};
const { collection, legoSetData, setId } = Astro.props;
const isWishlist = legoSetData.wishlist ?? false;
const cardAccentClass =
  collection === 'sets'
    ? 'hover:border-cyan-300 hover:shadow-cyan-900/10 dark:hover:border-cyan-300/70 dark:hover:shadow-cyan-950/30'
    : 'hover:border-fuchsia-300 hover:shadow-fuchsia-900/10 dark:hover:border-fuchsia-300/70 dark:hover:shadow-fuchsia-950/30';
const titleAccentClass =
  collection === 'sets'
    ? 'group-hover:text-cyan-700 dark:group-hover:text-cyan-300'
    : 'group-hover:text-fuchsia-700 dark:group-hover:text-fuchsia-300';
---

<a class="group flex h-full" href=`/${collection}/${setId}`>
  <article
    data-collection={collection}
    data-wishlist={isWishlist}
    class:list={[
      'relative flex h-full w-48 flex-col overflow-hidden rounded-2xl border border-slate-900/10 bg-white/85 pb-3 shadow-sm shadow-slate-900/10 transition duration-200 hover:shadow-lg dark:border-slate-700 dark:bg-slate-900/60 dark:shadow-slate-950/30',
      cardAccentClass,
    ]}
  >
    <div class="flex flex-1 items-center justify-center">
      <LegoSetImage
        img={legoSetData.img}
        alt={legoSetData.name}
        small
        vertical
      />
    </div>
    <header class="mx-2 mt-2">
      <h4
        class:list={[
          'card-title text-sm leading-5 font-semibold text-slate-900 underline-offset-2 transition group-hover:underline dark:text-slate-100',
          titleAccentClass,
        ]}
      >
        {legoSetData.name}
      </h4>
    </header>
  </article>
</a>
<style>
  [data-wishlist='true'] {
    position: relative;
  }
  [data-wishlist='true']::before {
    content: '★';
    position: absolute;
    top: 6px;
    right: 6px;
    display: inline-block;
    color: rgb(245, 158, 11);
    z-index: 1;
    filter: drop-shadow(0 2px 4px rgba(15, 23, 42, 0.35));
  }

  [data-collection='minifigs'][data-wishlist='true']::before {
    color: rgb(217, 70, 239);
  }

  .card-title {
    height: 2.5rem;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
</style>

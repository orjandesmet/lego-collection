---
import type { CollectionEntry } from 'astro:content';
import LegoSetImage from './LegoSetImage.astro';

type Props = {
  collection: 'sets' | 'minifigs';
  legoSetData: CollectionEntry<'sets' | 'minifigs'>['data'];
  setId: string;
  showVariant?: boolean;
};
const { collection, legoSetData, setId, showVariant } = Astro.props;
const isWishlist = legoSetData.wishlist ?? false;
const cardAccentClass =
  collection === 'sets'
    ? 'hover:border-cyan-300 hover:shadow-cyan-900/10'
    : 'hover:border-fuchsia-300 hover:shadow-fuchsia-900/10';
const titleAccentClass =
  collection === 'sets'
    ? 'group-hover:text-cyan-700'
    : 'group-hover:text-fuchsia-700';
---

<a class="group" href=`/${collection}/${setId}`>
  <article
    data-collection={collection}
    data-wishlist={isWishlist}
    class:list={[
      'relative flex w-48 flex-col gap-2 overflow-hidden rounded-2xl border border-slate-900/10 bg-white/85 pb-3 shadow-sm shadow-slate-900/10 transition duration-200 hover:-translate-y-1 hover:shadow-lg',
      cardAccentClass,
    ]}
  >
    <LegoSetImage img={legoSetData.img} alt={legoSetData.name} small />
    <header class="mx-2">
      <h4
        class:list={[
          'text-sm font-semibold text-slate-900 underline-offset-2 transition group-hover:underline',
          titleAccentClass,
        ]}
      >
        {legoSetData.name}
      </h4>
    </header>
  </article>
</a>
<style>
  [data-wishlist='true'] {
    position: relative;
  }
  [data-wishlist='true']::before {
    content: '★';
    position: absolute;
    top: 6px;
    right: 6px;
    display: inline-block;
    color: rgb(245, 158, 11);
    z-index: 1;
    filter: drop-shadow(0 2px 4px rgba(15, 23, 42, 0.35));
  }

  [data-collection='minifigs'][data-wishlist='true']::before {
    color: rgb(217, 70, 239);
  }
</style>

---
type Props = {
  pageTitle: string;
  showBreadcrumb?: boolean;
};

const { pageTitle, showBreadcrumb } = Astro.props;
const pathname = Astro.url.pathname;

const isActivePath = (href: string) => {
  if (href === '/') {
    return pathname === '/';
  }

  return pathname === href || pathname.startsWith(`${href}/`);
};

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/sets', label: 'Sets' },
  { href: '/minifigs', label: 'Minifigs' },
];
---

<body class="bg-slate-100 dark:bg-slate-900 dark:text-slate-400">
  <header
    class="sticky top-0 z-40 border-b border-slate-900/10 bg-white/80 backdrop-blur-md dark:border-slate-700 dark:bg-slate-950/70"
  >
    <nav
      class="mx-auto flex w-full max-w-7xl items-center justify-between gap-3 px-4 py-3 md:px-8"
    >
      <a
        href="/"
        class="text-sm font-semibold tracking-[0.08em] uppercase text-slate-700 dark:text-slate-200"
      >
        LEGO Collection
      </a>
      <ul class="flex items-center gap-2">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActivePath(item.href) ? 'page' : undefined}
                class:list={[
                  'rounded-full px-3 py-1.5 text-sm font-medium transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-500',
                  isActivePath(item.href)
                    ? 'bg-slate-900 text-white dark:bg-sky-300 dark:text-slate-950'
                    : 'text-slate-600 hover:bg-slate-200 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-slate-100',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </header>

  {
    showBreadcrumb && (
      <h1 class="max-w-7xl mx-auto px-2 md:px-4 py-4 text-xl font-bold text-sky-700 dark:text-sky-300">
        <a
          href="/"
          class="self-center border-t-4 border-l-4 border-solid border-sky-700 hover:border-sky-500 dark:boder-sky-300 h-4 w-4 -rotate-45"
        >
          &nbsp;
        </a>{' '}
        {pageTitle}
      </h1>
    )
  }
  <slot />
</body>

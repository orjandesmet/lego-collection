---
import BaseLayout from '@layouts/BaseLayout.astro';
import LegoBody from '@layouts/LegoBody.astro';
import { getCollection } from 'astro:content';

const pageTitle = 'Lego Collection';
const [allSets, allMinifigs] = await Promise.all([
  getCollection('sets'),
  getCollection('minifigs'),
]);

const ownedSets = allSets.filter(({ data }) => !data.wishlist);
const wishlistSets = allSets.filter(({ data }) => data.wishlist);
const ownedMinifigs = allMinifigs.filter(({ data }) => !data.wishlist);
const wishlistMinifigs = allMinifigs.filter(({ data }) => data.wishlist);

const totalBricks = [...ownedSets, ...ownedMinifigs].reduce(
  (sum, item) => sum + item.data.parts,
  0
);

const ownedSetsForDailyPick = ownedSets.toSorted((a, b) =>
  a.id.localeCompare(b.id)
);
const dailyPickCandidates = ownedSetsForDailyPick.map((set) => ({
  id: set.id,
  name: set.data.name,
  setNumber: set.data.setNumber,
  parts: set.data.parts,
}));
const recentlyAddedSets = ownedSets
  .toSorted((a, b) => b.data.dateAdded.localeCompare(a.data.dateAdded))
  .slice(0, 3);
---

<BaseLayout pageTitle={pageTitle}>
  <LegoBody pageTitle={pageTitle}>
    <main class="landing-shell relative isolate overflow-hidden">
      <div
        class="pointer-events-none absolute -left-16 top-12 h-56 w-56 rounded-full bg-amber-300/60 blur-3xl"
      >
      </div>
      <div
        class="pointer-events-none absolute right-0 top-24 h-64 w-64 rounded-full bg-cyan-300/50 blur-3xl"
      >
      </div>
      <div
        class="pointer-events-none absolute bottom-0 left-1/3 h-48 w-48 rounded-full bg-lime-300/45 blur-3xl"
      >
      </div>

      <section
        class="mx-auto flex w-full max-w-7xl flex-col gap-10 px-4 pb-8 pt-12 md:px-8 md:pt-20"
      >
        <header
          class="animate-rise rounded-3xl border border-slate-900/10 bg-white/75 p-6 shadow-lg shadow-slate-900/10 backdrop-blur-sm dark:border-slate-200/10 dark:bg-slate-900/60 dark:shadow-slate-950/40 md:p-10"
        >
          <p
            class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-500 dark:text-slate-300"
          >
            Personal LEGO archive
          </p>
          <h1
            class="mt-4 text-4xl font-bold leading-tight text-slate-900 dark:text-slate-100 md:text-6xl"
          >
            Bricks. Loads of Them.
          </h1>
          <p class="mt-4 max-w-3xl text-lg text-slate-700 dark:text-slate-200">
            Browse my growing collection or see what's on my wishlist.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href="/sets"
              class="rounded-full bg-slate-900 px-6 py-3 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:bg-slate-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-500 dark:bg-sky-300 dark:text-slate-950 dark:hover:bg-sky-200 dark:focus-visible:outline-sky-300"
            >
              Explore sets
            </a>
            <a
              href="/minifigs"
              class="rounded-full border border-slate-300 bg-white px-6 py-3 text-sm font-semibold text-slate-800 transition hover:-translate-y-0.5 hover:border-slate-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-500 dark:border-slate-500 dark:bg-slate-900/80 dark:text-slate-100 dark:hover:border-slate-300 dark:focus-visible:outline-slate-300"
            >
              Explore minifigs
            </a>
          </div>
        </header>

        <section class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
          <article
            class="animate-rise rounded-2xl border border-amber-200 bg-amber-100/70 p-5 shadow-sm shadow-amber-900/10 dark:border-amber-300/55 dark:bg-amber-950/45 dark:shadow-amber-950/40 [animation-delay:80ms]"
          >
            <p
              class="text-xs uppercase tracking-[0.16em] text-amber-800 dark:text-amber-200"
            >
              Owned sets
            </p>
            <p
              class="mt-3 text-4xl font-bold text-amber-950 dark:text-amber-100"
            >
              {ownedSets.length}
            </p>
          </article>
          <article
            class="animate-rise rounded-2xl border border-cyan-200 bg-cyan-100/70 p-5 shadow-sm shadow-cyan-900/10 dark:border-cyan-300/55 dark:bg-cyan-950/45 dark:shadow-cyan-950/40 [animation-delay:140ms]"
          >
            <p
              class="text-xs uppercase tracking-[0.16em] text-cyan-800 dark:text-cyan-200"
            >
              Set wishlist
            </p>
            <p class="mt-3 text-4xl font-bold text-cyan-950 dark:text-cyan-100">
              {wishlistSets.length}
            </p>
            <a
              href="/sets#wishlist"
              class="group mt-4 inline-flex items-center gap-2 rounded-full border border-cyan-300/80 bg-white/80 px-4 py-2 text-sm font-semibold text-cyan-900 shadow-sm shadow-cyan-900/10 transition hover:-translate-y-0.5 hover:border-cyan-400 hover:bg-white hover:shadow-md hover:shadow-cyan-900/20 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-700 dark:border-cyan-200/50 dark:bg-cyan-200/15 dark:text-cyan-100 dark:hover:border-cyan-100 dark:hover:bg-cyan-200/25 dark:hover:shadow-cyan-950/40 dark:focus-visible:outline-cyan-200"
            >
              <span>View wishlist</span>
              <span
                class="transition-transform duration-200 group-hover:translate-x-0.5"
              >
                &rarr;
              </span>
            </a>
          </article>
          <article
            class="animate-rise rounded-2xl border border-lime-200 bg-lime-100/70 p-5 shadow-sm shadow-lime-900/10 dark:border-lime-300/55 dark:bg-lime-950/45 dark:shadow-lime-950/40 [animation-delay:200ms]"
          >
            <p
              class="text-xs uppercase tracking-[0.16em] text-lime-800 dark:text-lime-200"
            >
              Owned minifigs
            </p>
            <p class="mt-3 text-4xl font-bold text-lime-950 dark:text-lime-100">
              {ownedMinifigs.length}
            </p>
          </article>
          <article
            class="animate-rise rounded-2xl border border-fuchsia-200 bg-fuchsia-100/70 p-5 shadow-sm shadow-fuchsia-900/10 dark:border-fuchsia-300/55 dark:bg-fuchsia-950/45 dark:shadow-fuchsia-950/40 [animation-delay:260ms]"
          >
            <p
              class="text-xs uppercase tracking-[0.16em] text-fuchsia-800 dark:text-fuchsia-200"
            >
              Total bricks
            </p>
            <p
              class="mt-3 text-4xl font-bold text-fuchsia-950 dark:text-fuchsia-100"
            >
              {totalBricks.toLocaleString('nl-BE')}
            </p>
          </article>
        </section>

        <section class="grid gap-4 lg:grid-cols-3">
          <article
            class="animate-rise rounded-2xl border border-slate-900/10 bg-white/80 p-6 shadow-md shadow-slate-900/10 backdrop-blur-sm dark:border-slate-200/10 dark:bg-slate-900/60 dark:shadow-slate-950/40 [animation-delay:320ms] lg:col-span-2"
          >
            <h2
              class="text-2xl font-semibold text-slate-900 dark:text-slate-100"
            >
              Recently added sets
            </h2>
            <ul class="mt-4 space-y-3">
              {
                recentlyAddedSets.map((set) => (
                  <li class="rounded-xl border border-slate-200 bg-white px-4 py-3 dark:border-slate-700 dark:bg-slate-800/80">
                    <a
                      href={`/sets/${set.id}`}
                      class="group flex flex-col gap-1 rounded-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-500 sm:flex-row sm:items-center sm:justify-between dark:focus-visible:outline-sky-300"
                    >
                      <span class="font-medium text-slate-900 group-hover:text-sky-700 dark:text-slate-100 dark:group-hover:text-sky-300">
                        {set.data.name}
                      </span>
                      <span class="text-sm text-slate-500 dark:text-slate-300">
                        {set.data.dateAdded}
                      </span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </article>

          <aside
            data-daily-pick-card
            class="animate-rise rounded-2xl border border-slate-900/10 bg-linear-to-br from-slate-900 to-slate-700 p-6 text-white shadow-md shadow-slate-900/25 dark:border-slate-100/10 dark:from-slate-950 dark:to-slate-800 [animation-delay:380ms]"
          >
            <h2 class="text-2xl font-semibold">Set of the day</h2>
            <p class="mt-3 text-slate-200" data-daily-pick-copy>
              Picking today's set...
            </p>
            <p class="mt-2 text-sm text-slate-200" data-daily-pick-meta></p>
            <a
              href="/sets"
              data-daily-pick-link
              class="mt-6 inline-block rounded-full bg-white px-5 py-2 text-sm font-semibold text-slate-900 transition hover:-translate-y-0.5 hover:bg-amber-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-200"
            >
              View sets
            </a>
          </aside>
        </section>
      </section>

      <script is:inline define:vars={{ dailyPickCandidates }}>
        (() => {
          const card = document.querySelector('[data-daily-pick-card]');
          if (!card) return;

          const copyEl = card.querySelector('[data-daily-pick-copy]');
          const metaEl = card.querySelector('[data-daily-pick-meta]');
          const linkEl = card.querySelector('[data-daily-pick-link]');
          if (!copyEl || !metaEl || !linkEl) return;

          if (
            !Array.isArray(dailyPickCandidates) ||
            dailyPickCandidates.length === 0
          ) {
            copyEl.textContent = 'Add an owned set to unlock daily picks.';
            metaEl.textContent = '';
            linkEl.textContent = 'View sets';
            linkEl.setAttribute('href', '/sets');
            return;
          }

          const now = new Date();
          const dayKey = [
            now.getFullYear(),
            String(now.getMonth() + 1).padStart(2, '0'),
            String(now.getDate()).padStart(2, '0'),
          ].join('-');

          const dayHash = Array.from(dayKey).reduce(
            (hash, char) => hash + char.charCodeAt(0),
            0
          );

          const pick =
            dailyPickCandidates[dayHash % dailyPickCandidates.length];
          copyEl.textContent = `Today's build is ${pick.name}.`;
          metaEl.textContent = `#${pick.setNumber} • ${new Intl.NumberFormat('nl-BE').format(pick.parts)} pieces`;
          linkEl.textContent = 'Open set of the day';
          linkEl.setAttribute('href', `/sets/${pick.id}`);
        })();
      </script>
    </main>
  </LegoBody>
</BaseLayout>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Chivo:wght@400;600;700&family=Sora:wght@500;700;800&display=swap');

  .landing-shell {
    background:
      radial-gradient(
        circle at 12% 16%,
        rgba(251, 191, 36, 0.24),
        transparent 40%
      ),
      radial-gradient(
        circle at 82% 22%,
        rgba(34, 211, 238, 0.2),
        transparent 43%
      ),
      radial-gradient(
        circle at 62% 84%,
        rgba(163, 230, 53, 0.18),
        transparent 46%
      ),
      linear-gradient(180deg, #f8fafc 0%, #eef2ff 100%);
    min-height: 100dvh;
    font-family: 'Chivo', 'Avenir Next', 'Trebuchet MS', sans-serif;
  }

  :global(.dark) .landing-shell {
    background:
      radial-gradient(
        circle at 14% 16%,
        rgba(251, 191, 36, 0.16),
        transparent 36%
      ),
      radial-gradient(
        circle at 82% 22%,
        rgba(34, 211, 238, 0.14),
        transparent 40%
      ),
      radial-gradient(
        circle at 62% 84%,
        rgba(163, 230, 53, 0.12),
        transparent 44%
      ),
      linear-gradient(180deg, #020617 0%, #0f172a 100%);
  }

  @media (prefers-color-scheme: dark) {
    .landing-shell {
      background:
        radial-gradient(
          circle at 14% 16%,
          rgba(251, 191, 36, 0.16),
          transparent 36%
        ),
        radial-gradient(
          circle at 82% 22%,
          rgba(34, 211, 238, 0.14),
          transparent 40%
        ),
        radial-gradient(
          circle at 62% 84%,
          rgba(163, 230, 53, 0.12),
          transparent 44%
        ),
        linear-gradient(180deg, #020617 0%, #0f172a 100%);
    }
  }

  .landing-shell h1,
  .landing-shell h2 {
    font-family: 'Sora', 'Franklin Gothic Medium', 'Trebuchet MS', sans-serif;
    letter-spacing: -0.02em;
  }

  .animate-rise {
    animation: rise 620ms ease-out both;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 48rem) {
    .landing-shell {
      background:
        radial-gradient(
          circle at 20% 10%,
          rgba(251, 191, 36, 0.3),
          transparent 36%
        ),
        radial-gradient(
          circle at 78% 14%,
          rgba(34, 211, 238, 0.24),
          transparent 38%
        ),
        linear-gradient(180deg, #f8fafc 0%, #eff6ff 100%);
    }

    :global(.dark) .landing-shell {
      background:
        radial-gradient(
          circle at 20% 10%,
          rgba(251, 191, 36, 0.18),
          transparent 34%
        ),
        radial-gradient(
          circle at 78% 14%,
          rgba(34, 211, 238, 0.16),
          transparent 36%
        ),
        linear-gradient(180deg, #020617 0%, #0f172a 100%);
    }

    @media (prefers-color-scheme: dark) {
      .landing-shell {
        background:
          radial-gradient(
            circle at 20% 10%,
            rgba(251, 191, 36, 0.18),
            transparent 34%
          ),
          radial-gradient(
            circle at 78% 14%,
            rgba(34, 211, 238, 0.16),
            transparent 36%
          ),
          linear-gradient(180deg, #020617 0%, #0f172a 100%);
      }
    }
  }
</style>

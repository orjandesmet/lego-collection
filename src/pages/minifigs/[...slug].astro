---
import type { InferGetStaticPropsType } from 'astro';
import { getCollection } from 'astro:content';

import BackgroundBlobs from '@components/BackgroundBlobs.astro';
import LegoSetDetail from '@components/LegoSetDetail.astro';
import LegoSetRecirculation from '@components/LegoSetRecirculation.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import LegoBody from '@layouts/LegoBody.astro';
import { recirculationUtils } from '@utils/recirculationUtils';

export async function getStaticPaths() {
  const legoSets = await getCollection('minifigs');
  return legoSets.map((entry, _, arr) => ({
    params: { slug: entry.id },
    props: {
      legoSet: entry,
      moreSets: recirculationUtils.populateOtherSets(entry, arr, 12),
    },
  }));
}

// An interface or type with this name is automatically used in Astro.props
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { legoSet, moreSets } = Astro.props;
const pageTitle = legoSet.data.name;
---

<BaseLayout pageTitle={pageTitle}>
  <LegoBody pageTitle={pageTitle}>
    <main
      class="theme-shell theme-shell--detail theme-shell--minifigs relative isolate overflow-hidden"
    >
      <BackgroundBlobs collection="minifigs" variant="detail" />

      <section
        class="mx-auto flex w-full max-w-7xl flex-col gap-5 px-4 pb-10 pt-10 md:px-8 md:pt-14"
      >
        <LegoSetDetail collection="minifigs" legoSetData={legoSet.data} />
        {
          moreSets && (
            <LegoSetRecirculation
              collection="minifigs"
              title="Related minifigs"
              sets={moreSets}
              showVariant
            />
          )
        }
      </section>
    </main>
  </LegoBody>
</BaseLayout>

---
import LegoSetListItem from '@components/LegoSetListItem.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import LegoBody from '@layouts/LegoBody.astro';
import { getCollection } from 'astro:content';

const allLegominifigs = await getCollection('minifigs');
const allThemes = await getCollection('themes');

const themesInminifigs = new Set(
  allLegominifigs.map((minifig) => minifig.data.themeId.id)
);

const pageTitle = 'Lego minifigs';
const ownedMinifigs = allLegominifigs.filter(({ data }) => !data.wishlist);
const wishlistMinifigs = allLegominifigs.filter(({ data }) => data.wishlist);
---

<BaseLayout pageTitle={pageTitle} withTailwind>
  <LegoBody pageTitle={pageTitle}>
    <main class="collection-shell relative isolate overflow-hidden">
      <div
        class="pointer-events-none absolute -left-12 top-16 h-52 w-52 rounded-full bg-fuchsia-300/45 blur-3xl"
      >
      </div>
      <div
        class="pointer-events-none absolute right-0 top-24 h-64 w-64 rounded-full bg-lime-300/40 blur-3xl"
      >
      </div>

      <section
        class="mx-auto flex w-full max-w-7xl flex-col gap-6 px-4 pb-10 pt-10 md:px-8 md:pt-14"
      >
        <header
          class="animate-rise rounded-3xl border border-slate-900/10 bg-white/75 p-6 shadow-lg shadow-slate-900/10 backdrop-blur-sm md:p-8"
        >
          <p
            class="text-sm font-semibold uppercase tracking-[0.16em] text-slate-500"
          >
            Minifig overview
          </p>
          <h1 class="mt-3 text-4xl font-bold text-slate-900 md:text-5xl">
            My LEGO minifigs
          </h1>
          <div class="mt-5 grid gap-3 sm:grid-cols-3">
            <p
              class="rounded-xl border border-lime-200 bg-lime-100/70 px-3 py-2 text-sm text-lime-950"
            >
              <strong>{ownedMinifigs.length}</strong> owned
            </p>
            <p
              class="rounded-xl border border-fuchsia-200 bg-fuchsia-100/70 px-3 py-2 text-sm text-fuchsia-950"
            >
              <strong>{wishlistMinifigs.length}</strong> wishlist
            </p>
            <p
              class="rounded-xl border border-lime-200 bg-lime-100/70 px-3 py-2 text-sm text-lime-950"
            >
              <strong>{themesInminifigs.size}</strong> active themes
            </p>
          </div>
        </header>

        {
          Array.from(themesInminifigs)
            .sort()
            .toReversed()
            .map((themeId, index) => (
              <section
                class="animate-rise rounded-2xl border border-slate-900/10 bg-white/75 p-4 shadow-md shadow-slate-900/10 backdrop-blur-sm md:p-6"
                style={`animation-delay:${80 + index * 40}ms`}
              >
                <div class="mb-4 flex items-center justify-between gap-2">
                  <h2 class="text-2xl font-semibold text-slate-900">
                    {
                      allThemes.find((theme) => theme.id === themeId)?.data
                        ?.name
                    }
                  </h2>
                  <p class="text-sm text-slate-500">
                    {
                      allLegominifigs.filter(
                        (minifig) => minifig.data.themeId.id === themeId
                      ).length
                    }{' '}
                    items
                  </p>
                </div>
                <ul class="grid gap-3 md:grid-cols-2 xl:grid-cols-3">
                  {allLegominifigs
                    .filter((minifig) => minifig.data.themeId.id === themeId)
                    .sort((a, b) => {
                      const variantA = Number(
                        a.data.setNumber.split('-')[1] || ''
                      );
                      const variantB = Number(
                        b.data.setNumber.split('-')[1] || ''
                      );
                      return variantA - variantB;
                    })
                    .map((minifig) => (
                      <li>
                        <LegoSetListItem
                          collection="minifigs"
                          legoSetData={minifig.data}
                          setId={minifig.id}
                          showVariant
                        />
                      </li>
                    ))}
                </ul>
              </section>
            ))
        }
      </section>
    </main>
  </LegoBody>
</BaseLayout>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Chivo:wght@400;600;700&family=Sora:wght@500;700;800&display=swap');

  .collection-shell {
    min-height: 100dvh;
    background:
      radial-gradient(
        circle at 14% 16%,
        rgba(217, 70, 239, 0.18),
        transparent 40%
      ),
      radial-gradient(
        circle at 82% 24%,
        rgba(163, 230, 53, 0.18),
        transparent 40%
      ),
      linear-gradient(180deg, #f8fafc 0%, #eef2ff 100%);
    font-family: 'Chivo', 'Avenir Next', 'Trebuchet MS', sans-serif;
  }

  .collection-shell h1,
  .collection-shell h2 {
    font-family: 'Sora', 'Franklin Gothic Medium', 'Trebuchet MS', sans-serif;
    letter-spacing: -0.02em;
  }

  .animate-rise {
    animation: rise 620ms ease-out both;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

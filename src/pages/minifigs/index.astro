---
import CollectionHeader from '@components/CollectionHeader.astro';
import CollectionSection from '@components/CollectionSection.astro';
import CollectionSetGrid from '@components/CollectionSetGrid.astro';
import ThemedPageShell from '@components/ThemedPageShell.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import LegoBody from '@layouts/LegoBody.astro';
import { setUtils } from '@utils/setUtils';
import { getCollection } from 'astro:content';

const allLegominifigs = await getCollection('minifigs');
const allThemes = await getCollection('themes');

const themesInminifigs = new Set(
  allLegominifigs.map((minifig) => minifig.data.themeId.id)
);

const pageTitle = 'Lego minifigs';
const ownedMinifigs = allLegominifigs.filter(({ data }) => !data.wishlist);
const wishlistMinifigs = allLegominifigs.filter(({ data }) => data.wishlist);
const minifigsByTheme = Array.from(themesInminifigs)
  .sort()
  .toReversed()
  .map((themeId) => ({
    themeId,
    items: setUtils.sortByVariant(
      allLegominifigs.filter((minifig) => minifig.data.themeId.id === themeId)
    ),
  }));
---

<BaseLayout pageTitle={pageTitle}>
  <LegoBody pageTitle={pageTitle}>
    <ThemedPageShell collection="minifigs" variant="collection">
      <section
        class="mx-auto flex w-full max-w-7xl flex-col gap-6 px-4 pb-10 pt-10 md:px-8 md:pt-14"
      >
        <CollectionHeader
          overviewLabel="Minifig overview"
          title="My LEGO minifigs"
          stats={[
            { label: 'owned', value: ownedMinifigs.length, accent: 'lime' },
            {
              label: 'wishlist',
              value: wishlistMinifigs.length,
              accent: 'fuchsia',
            },
            {
              label: 'collections',
              value: themesInminifigs.size,
              accent: 'cyan',
            },
          ]}
        />

        <div class="animate-rise" style="animation-delay:50ms">
          <label for="minifig-search" class="sr-only">Search minifigs</label>
          <input
            id="minifig-search"
            type="search"
            placeholder="Search by name, number or theme..."
            class="w-full rounded-xl border border-slate-900/10 bg-white/75 px-4 py-2.5 text-sm text-slate-900 shadow-sm backdrop-blur-sm placeholder:text-slate-400 focus:border-fuchsia-400 focus:outline-none focus:ring-2 focus:ring-fuchsia-400/30 dark:border-slate-700 dark:bg-slate-900/60 dark:text-slate-100 dark:placeholder:text-slate-500 dark:focus:border-fuchsia-500 dark:focus:ring-fuchsia-500/20"
          />
        </div>

        {
          minifigsByTheme.map(({ themeId, items }, index) => (
            <div data-search-section>
              <CollectionSection
                accent="lime"
                title={
                  allThemes.find((theme) => theme.id === themeId)?.data?.name ??
                  themeId
                }
                meta={`${items.length} items`}
                animationDelayMs={80 + index * 40}
              >
                <CollectionSetGrid
                  collection="minifigs"
                  items={items}
                  showVariant
                />
              </CollectionSection>
            </div>
          ))
        }
      </section>
    </ThemedPageShell>
  </LegoBody>
</BaseLayout>

<script>
  import { initCollectionSearch } from '@scripts/collection-search';
  initCollectionSearch('#minifig-search');
</script>

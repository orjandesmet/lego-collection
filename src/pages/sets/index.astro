---
import BackgroundBlobs from '@components/BackgroundBlobs.astro';
import CollectionHeader from '@components/CollectionHeader.astro';
import CollectionSection from '@components/CollectionSection.astro';
import CollectionSetGrid from '@components/CollectionSetGrid.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import LegoBody from '@layouts/LegoBody.astro';
import { getCollection } from 'astro:content';

const allLegoSets = await getCollection('sets');
const pageTitle = 'Lego sets';
const wishlistSets = allLegoSets.filter(({ data: { wishlist } }) => !!wishlist);
const ownedSets = allLegoSets.filter(({ data: { wishlist } }) => !wishlist);
const uniqueThemes = new Set(allLegoSets.map((set) => set.data.themeId.id));
---

<BaseLayout pageTitle={pageTitle}>
  <LegoBody pageTitle={pageTitle}>
    <main
      class="theme-shell theme-shell--collection theme-shell--sets relative isolate overflow-hidden"
    >
      <BackgroundBlobs collection="sets" variant="collection" />

      <section
        class="mx-auto flex w-full max-w-7xl flex-col gap-6 px-4 pb-10 pt-10 md:px-8 md:pt-14"
      >
        <CollectionHeader
          overviewLabel="Set overview"
          title="My LEGO sets"
          stats={[
            { label: 'owned', value: ownedSets.length, accent: 'amber' },
            { label: 'wishlist', value: wishlistSets.length, accent: 'cyan' },
            { label: 'themes', value: uniqueThemes.size, accent: 'lime' },
          ]}
        />

        <CollectionSection
          accent="cyan"
          className="scroll-mt-28"
          id="wishlist"
          title="Wishlist"
          meta={`${wishlistSets.length} sets`}
          animationDelayMs={100}
        >
          <CollectionSetGrid collection="sets" items={wishlistSets} />
        </CollectionSection>

        <CollectionSection
          accent="fuchsia"
          title="Owned"
          meta="Newest first"
          animationDelayMs={180}
        >
          <CollectionSetGrid
            collection="sets"
            items={ownedSets.sort((setA, setB) =>
              setB.data.dateAdded.localeCompare(setA.data.dateAdded)
            )}
          />
        </CollectionSection>
      </section>
    </main>
  </LegoBody>
</BaseLayout>
